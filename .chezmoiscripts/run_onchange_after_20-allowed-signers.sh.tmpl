#!/bin/sh
set -eu

KEY="$HOME/.ssh/id_ed25519.pub"
OUT="${XDG_CONFIG_HOME:-$HOME/.config}/git/allowed_signers"
# key-sha256: {{ $key := joinPath .chezmoi.homeDir ".ssh" "id_ed25519.pub" }}{{ if stat $key }}{{ output "cat" $key | sha256sum }}{{ else }}missing{{ end }}

if [ ! -r "$KEY" ]; then
    rm -f "$OUT"
    exit 0
fi

mkdir -p "$(dirname "$OUT")"

printf '%s namespaces="git" %s\n' \
    {{ .git_email | quote }} "$(cut -d' ' -f1,2 <"$KEY")" >"$OUT"

if [ -r "$OUT.local" ]; then
    cat "$OUT.local" >>"$OUT"
fi

chmod 600 "$OUT"
