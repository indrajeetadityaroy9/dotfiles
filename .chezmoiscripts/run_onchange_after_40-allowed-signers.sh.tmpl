#!/bin/sh
# Generate ~/.config/git/allowed_signers from THIS machine's public key.
#
# The file was untracked in 91d9721 (it ties machines together), which left
# `git log --show-signature` silently broken on every new machine with no hint
# in the bootstrap checklist. Deriving it locally closes that gap without
# putting anything machine-identifying into a public repo.
#
# signer-identity: {{ .git_email }}
set -eu

KEY="$HOME/.ssh/id_ed25519.pub"
OUT="${XDG_CONFIG_HOME:-$HOME/.config}/git/allowed_signers"

if [ ! -r "$KEY" ]; then
    echo "no $KEY yet — skipping allowed_signers (re-run 'chezmoi apply' after adding your key)"
    exit 0
fi

mkdir -p "$(dirname "$OUT")"

# keytype + base64 only; drop the trailing comment field.
printf '%s namespaces="git" %s\n' \
    {{ .git_email | quote }} "$(cut -d' ' -f1,2 <"$KEY")" >"$OUT"

# Additional signers (your other machines' public keys) go in this untracked
# file so they never reach the public repo.
if [ -r "$OUT.local" ]; then
    cat "$OUT.local" >>"$OUT"
fi

chmod 600 "$OUT"
echo "wrote $OUT"
