#!/bin/sh
set -eu

KEY="$HOME/.ssh/id_ed25519.pub"
OUT="${XDG_CONFIG_HOME:-$HOME/.config}/git/allowed_signers"

if [ ! -r "$KEY" ]; then
    echo "no $KEY yet — skipping allowed_signers (re-run 'chezmoi apply' after adding your key)"
    exit 0
fi

mkdir -p "$(dirname "$OUT")"

printf '%s namespaces="git" %s\n' \
    {{ .git_email | quote }} "$(cut -d' ' -f1,2 <"$KEY")" >"$OUT"

if [ -r "$OUT.local" ]; then
    cat "$OUT.local" >>"$OUT"
fi

chmod 600 "$OUT"
echo "wrote $OUT"
