{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions",
    "mise"
  ],
  "minimumReleaseAge": "3 days",
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "Runtime channels; `mise run update` advances them in mise.lock.",
      "matchDepNames": [
        "python",
        "node",
        "rust",
        "java"
      ],
      "enabled": false
    },
    {
      "description": "One PR for routine bumps.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "tools"
    }
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies"
  ]
}
