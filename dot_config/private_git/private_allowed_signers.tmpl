{{- $key := joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub" -}}
{{- $local := joinPath .chezmoi.homeDir ".config/git/allowed_signers.local" -}}
{{- if stat $key -}}
{{- $f := include $key | trim | splitList " " -}}
{{ .git_email }} namespaces="git" {{ index $f 0 }} {{ index $f 1 }}
{{ end -}}
{{- if stat $local -}}
{{ include $local | trim }}
{{ end -}}
