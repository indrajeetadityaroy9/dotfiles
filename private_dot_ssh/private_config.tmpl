# Host-specific config lives in ~/.ssh/config.d/*.conf — untracked, per-machine,
# mode 600. Deliberately not in this public repo: a MagicDNS name or LAN IP is
# exactly the kind of metadata that should not be published.
# ssh_config is FIRST-VALUE-WINS, so this Include must stay above `Host *`
# for per-host overrides to take effect.
Include ~/.ssh/config.d/*.conf

Host github.com
  HostName github.com
  User git

Host *
  AddKeysToAgent yes
{{ if eq .chezmoi.os "darwin" }}  UseKeychain yes
{{ end }}  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  HashKnownHosts yes
  # Keep long-lived sessions (e.g. over Tailscale) from dying silently.
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # Reuse one TCP connection per host: subsequent ssh/scp/git are near-instant.
  # %C is a hash, which keeps the socket path short enough for macOS.
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m
